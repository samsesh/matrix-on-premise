# Synapse Configuration
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_REPORT_STATS=yes

# System Configuration
TZ=UTC

# User and Group IDs (optional, defaults to 991)
UID=991
GID=991

# TURN Server Configuration
TURN_SERVER=localhost
TURN_SHARED_SECRET=

# Element Web Configuration
MATRIX_THEMES=light,dark

# Element Call Configuration
ELEMENT_CALL_PORT=8082

# LiveKit Configuration (for MatrixRTC backend)
LIVEKIT_KEY=devkey
LIVEKIT_SECRET=secret
# Note: Change these to secure random values in production!
# You can generate a secure secret with: openssl rand -hex 32

# LiveKit Domain Configuration
LIVEKIT_DOMAIN=localhost
LIVEKIT_JWT_DOMAIN=localhost

# WebRTC Port Range for LiveKit
WEBRTC_PORT_START=50000
WEBRTC_PORT_END=60000

# Jitsi Meet Configuration
JITSI_HTTP_PORT=8443
JITSI_HTTPS_PORT=8444
JITSI_ENABLE_AUTH=0
JITSI_ENABLE_GUESTS=1
JITSI_ENABLE_LETSENCRYPT=0
JITSI_ENABLE_HTTP_REDIRECT=1
JITSI_ENABLE_TRANSCRIPTIONS=0
JITSI_DISABLE_HTTPS=1
JITSI_ENABLE_RECORDING=0
JITSI_AUTH_TYPE=internal
JITSI_PUBLIC_URL=https://meet.jitsi
# Set this to your server's public IP for Jitsi
JITSI_DOCKER_HOST_ADDRESS=
# Jitsi secrets (will be generated during setup)
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
# Jitsi JVB ports
JVB_PORT=10000
JVB_TCP_PORT=4443

# Sygnal Push Notification Gateway
SYGNAL_PORT=127.0.0.1:5000
# Push gateway configuration (optional)
PUSH_GATEWAY_URL=
PUSH_GATEWAY_ENABLED=false

# LDAP Authentication (optional)
# Set LDAP_ENABLED=true to enable LDAP auth for Synapse
LDAP_ENABLED=false
# LDAP server URI (use ldap://openldap:1389 for self-hosted OpenLDAP)
LDAP_URI=ldap://openldap:1389
LDAP_BASE=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_FILTER=(objectClass=inetOrgPerson)
LDAP_UID_ATTR=uid
LDAP_MAIL_ATTR=mail
LDAP_NAME_ATTR=givenName
LDAP_START_TLS=false
# Self-hosted OpenLDAP settings (only used when LDAP_ENABLED=true and using built-in OpenLDAP)
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=
LDAP_PORT=389
LDAP_LOGLEVEL=0
